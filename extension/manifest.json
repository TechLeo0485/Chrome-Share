{
  "manifest_version": 3,
  "name": "TabShare Remote Control",
  "version": "0.9.0",
  "description": "Share one Chrome tab (screen + mouse/keyboard control) with a trusted friend, peer-to-peer over WebRTC. No account setup — send one short code and it connects automatically.",

  "key": "",

  "permissions": [
    "tabCapture",
    "activeTab",
    "debugger",
    "offscreen",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://0.peerjs.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "host.html",
    "default_title": "TabShare Remote Control",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "minimum_chrome_version": "116"
}
